# Managed by Ansible.
services:
  kibana:
    image: ${KIBANA_IMAGE}
    container_name: kibana
    restart: unless-stopped
    environment:
      - SERVER_NAME=kibana
      - SERVER_HOST=0.0.0.0
      - ELASTICSEARCH_HOSTS=${ES_HOSTS}
{% if kibana_publicbaseurl | length > 0 %}
      - SERVER_PUBLICBASEURL=${PUBLIC_BASE_URL}
{% endif %}
{% if es_security_enabled | bool %}
      - ELASTICSEARCH_USERNAME=${ELASTICSEARCH_USERNAME}
      - ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}
      - ELASTICSEARCH_SSL_CERTIFICATEAUTHORITIES=${ELASTICSEARCH_SSL_CERTIFICATEAUTHORITIES}
{% endif %}
{% if kibana_tls_enabled | bool %}
      - SERVER_SSL_ENABLED=true
      - SERVER_SSL_CERTIFICATE=/usr/share/kibana/config/letsencrypt/fullchain.pem
      - SERVER_SSL_KEY=/usr/share/kibana/config/letsencrypt/privkey.pem
{% endif %}
{% if es_security_enabled | bool or kibana_tls_enabled | bool %}
    volumes:
{% if es_security_enabled | bool %}
      - {{ es_shared_certs_dir }}:/usr/share/kibana/config/certs:ro
{% endif %}
{% if kibana_tls_enabled | bool %}
      # Sibling path, NOT nested under config/certs above — config/certs is
      # itself a read-only bind mount when es_security_enabled, and Docker
      # can't create a child mountpoint inside another read-only bind mount
      # (confirmed empirically: "read-only file system" on container create).
      - {{ elastic_base_dir }}/kibana/certs:/usr/share/kibana/config/letsencrypt:ro
{% endif %}
{% endif %}
    ports:
      - "${KIBANA_PORT}:5601"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsSk {{ 'https' if (kibana_tls_enabled | bool) else 'http' }}://localhost:5601/api/status || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 12
