# Managed by Ansible.
services:
  apm-server:
    image: ${APM_SERVER_IMAGE}
    container_name: apm-server
    restart: unless-stopped
    # --strict.perms=false: the config file below is bind-mounted and owned
    # by the host user, not the container's apm-server user — same reason
    # Elastic's own docs pass this flag for a Docker deployment.
    # -e: log to stderr, so `docker logs` shows APM Server's own logs.
    command: ["--strict.perms=false", "-e"]
    volumes:
      - ./apm-server.yml:/usr/share/apm-server/apm-server.yml:ro
{% if es_security_enabled | bool %}
      - {{ es_shared_certs_dir }}:/usr/share/apm-server/certs:ro
{% endif %}
    ports:
      - "${APM_SERVER_PORT}:8200"
    # No curl (or wget/nc) in this image — verified empirically, unlike the
    # ES/Kibana images. /bin/sh here is actually bash, so a bare TCP-connect
    # via /dev/tcp needs nothing extra and is enough to confirm the server
    # is accepting connections.
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/8200 || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 12
