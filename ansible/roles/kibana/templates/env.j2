KIBANA_IMAGE={{ kibana_image }}
KIBANA_PORT={{ kibana_port }}
# Point Kibana at every ES node's HTTP endpoint. Kibana's docker-entrypoint
# (kibana-docker) passes env values straight through as CLI longopts
# (--elasticsearch.hosts=<value>) with no comma-splitting of its own — the
# array-typed elasticsearch.hosts setting only accepts either one URI or a
# JSON-encoded array string. A plain comma-joined list fails config
# validation ("could not parse array value from json input"); verified
# empirically against a live cluster. The JSON must also be whitespace-free:
# kibana-docker's final `exec ... ${longopts}` line expands unquoted, so
# bash word-splits on any space and shreds the array into garbage argv —
# also verified empirically (a `to_json`-default "a, b" array broke the
# same way the comma-joined string did, just differently).
ES_HOSTS={{ (groups['elasticsearch'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '^', 'http://') | map('regex_replace', '$', ':' ~ es_http_port) | list) | to_json | replace(', ', ',') }}
PUBLIC_BASE_URL={{ kibana_publicbaseurl }}
