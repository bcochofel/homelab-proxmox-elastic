# Per-node values — rendered by Ansible. Cluster formation derives from the
# Terraform-generated inventory (es_seed_hosts / es_initial_master_nodes).
ES_IMAGE={{ es_image }}
NODE_NAME={{ es_node_name }}
CLUSTER_NAME={{ cluster_name }}
PUBLISH_HOST={{ ansible_host }}

# discovery.seed_hosts: every ES node's transport endpoint.
SEED_HOSTS={{ groups['elasticsearch'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '$', ':' ~ es_transport_port) | join(',') }}

# initial_master_nodes: node names (only used on first bootstrap).
INITIAL_MASTER_NODES={{ groups['elasticsearch'] | map('extract', hostvars, 'es_node_name') | join(',') }}

HEAP_SIZE={{ es_heap_size }}
MEMORY_LOCK={{ es_bootstrap_memory_lock | lower }}
SECURITY_ENABLED={{ es_security_enabled | lower }}
HTTP_PORT={{ es_http_port }}
TRANSPORT_PORT={{ es_transport_port }}
