# Managed by Ansible — self-managed APM Server (not the Fleet-managed APM
# integration; Fleet Server isn't up yet, see "Security sequencing" in
# CLAUDE.md). Rendered directly by Jinja2 rather than via Beats' own
# runtime ${VAR} env-var expansion, so the Elasticsearch hosts list doesn't
# depend on getting Beats' complex-value env-var syntax exactly right.
apm-server:
  host: "0.0.0.0:{{ apm_server_port }}"

output.elasticsearch:
  hosts:
{% for node in groups['elasticsearch'] %}
    - "{{ 'https' if (es_security_enabled | bool) else 'http' }}://{{ hostvars[node].ansible_host }}:{{ es_http_port }}"
{% endfor %}
{% if es_security_enabled | bool %}
  ssl.certificate_authorities: ["/usr/share/apm-server/certs/ca.crt"]
  # id:api_key, minted once by the es_security_bootstrap role (see
  # playbooks/15-elasticsearch-security.yml) — not the elastic superuser.
  api_key: "{{ lookup('file', es_secrets_local_cache_dir ~ '/apm_api_key.txt') }}"
{% endif %}

logging:
  level: info
  to_stderr: true
