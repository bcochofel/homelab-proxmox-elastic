# ============================================================================
# GENERATED BY TERRAFORM — DO NOT EDIT BY HAND.
# Re-run `terraform apply` to regenerate after changing node definitions.
# Hand-authored tuning lives in ansible/group_vars/, which is never overwritten.
# ============================================================================
[elasticsearch]
%{ for node in es_nodes ~}
${node.name} ansible_host=${node.ip} es_node_name=${node.name}
%{ endfor ~}

[kibana]
${kibana_name} ansible_host=${kibana_ip}

[apm_server]
${apm_server_name} ansible_host=${apm_server_ip}

[otel_demo]
${otel_demo_name} ansible_host=${otel_demo_ip}

[all:vars]
ansible_user=${ansible_user}
cluster_name=${cluster_name}
# Derived from Terraform-known IPs — drives cluster formation in Ansible.
es_seed_hosts=${join(",", [for n in es_nodes : n.ip])}
es_initial_master_nodes=${join(",", [for n in es_nodes : n.name])}
