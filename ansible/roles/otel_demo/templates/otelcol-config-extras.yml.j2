# Managed by Ansible (otel_demo role) — do not edit on the host.
# Loaded last by the collector, merged over src/otel-collector/otelcol-config.yml.
# Adds an OTLP exporter pointed at the self-managed APM Server and wires it
# into the traces pipeline alongside the upstream debug/span_metrics
# exporters (repeated here because the collector replaces arrays on merge,
# it doesn't append to them).
exporters:
  otlp/apm-server:
    endpoint: {{ hostvars[groups['apm_server'][0]].ansible_host }}:{{ apm_server_port }}
    tls:
      insecure: true

service:
  pipelines:
    traces:
      exporters: [debug, span_metrics, otlp/apm-server]
