KIBANA_IMAGE={{ kibana_image }}
KIBANA_PORT={{ kibana_port }}
# Point Kibana at every ES node's HTTP endpoint.
ES_HOSTS={{ groups['elasticsearch'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '$', ':' ~ es_http_port) | map('regex_replace', '^', 'http://') | join(',') }}
PUBLIC_BASE_URL={{ kibana_publicbaseurl }}
