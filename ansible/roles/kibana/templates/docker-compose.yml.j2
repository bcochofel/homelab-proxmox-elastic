# Managed by Ansible.
services:
  kibana:
    image: ${KIBANA_IMAGE}
    container_name: kibana
    restart: unless-stopped
    environment:
      - SERVER_NAME=kibana
      - SERVER_HOST=0.0.0.0
      - ELASTICSEARCH_HOSTS=${ES_HOSTS}
{% if kibana_publicbaseurl | length > 0 %}
      - SERVER_PUBLICBASEURL=${PUBLIC_BASE_URL}
{% endif %}
    ports:
      - "${KIBANA_PORT}:5601"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5601/api/status || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 12
